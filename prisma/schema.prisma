datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Produto {
  id         String   @id @default(uuid())
  codigo     String?
  nome       String
  categoria  String   @default("Outros")
  quantidade Int
  preco      Float?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}